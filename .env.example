# Copy to server/.env for local use (loaded automatically), or set these in your host dashboard.
# Only JWT_SECRET and DATABASE_URL are required in production.

NODE_ENV=development
PORT=3001

# REQUIRED in production (>= 16 chars). Generate one with:  openssl rand -base64 48
JWT_SECRET=

# PostgreSQL connection string. Local default (matches `docker compose up -d db`):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collab_notes
# Managed hosts (Neon, Supabase, Render, Railway…) usually need TLS, e.g. ...?sslmode=require

# Optional: use a non-default schema, and cap the connection pool (default 10).
DB_SCHEMA=
DB_POOL_MAX=10

# Extra browser origins allowed for CORS/WebSocket. Not needed when the server serves the client itself.
CORS_ORIGINS=

# Directory of the built client; when set, the server serves the SPA too (single-container deploy).
STATIC_DIR=

# How many reverse proxies sit in front of the app (Render/Fly/Railway/nginx = 1). Needed for correct
# client IPs, which the login rate limiter uses.
TRUST_PROXY=0

# bcrypt cost factor (4-15)
BCRYPT_ROUNDS=10
